{
  "appId": "touchtype",
  "repository": "nirav2000/TouchType",
  "liveUrl": "https://nirav2000.github.io/TouchType/",
  "productVersionFile": "version.json",
  "snapshotSafety": "visual-only",
  "snapshot": {
    "entry": "index.html",
    "exclude": []
  },
  "readOnlyAdapter": {
    "allowedOrigins": [],
    "allowReadPostPatterns": [],
    "blockPatterns": []
  },
  "platform": {
    "contract": "v1"
  },
  "data": {
    "provider": "localStorage",
    "schemaVersion": "1",
    "paths": ["touchtype:v1"]
  }
}
